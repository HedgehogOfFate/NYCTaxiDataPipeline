FROM apache/airflow:2.9.3-python3.11

USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jre-headless curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

USER airflow
COPY requirements.txt requirements-airflow.txt /tmp/

# Installed against Airflow's official constraints file for 2.9.3 so pip can't
# silently resolve a newer/incompatible Airflow or provider version -- the same
# reasoning documented in requirements-airflow.txt's header comment. requirements.txt
# is included here too (not just requirements-airflow.txt) so the image has the
# same pyspark/pandas/etc. versions the local dev environment and CI use, keeping
# "works on my machine" and "works in the container" the same machine, effectively.
RUN pip install --no-cache-dir \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.9.3/constraints-3.11.txt" \
    -r /tmp/requirements.txt -r /tmp/requirements-airflow.txt

# JDBC driver for Spark -> Postgres writes in the gold layer
RUN mkdir -p /opt/airflow/jars && \
    curl -sL -o /opt/airflow/jars/postgresql-42.7.3.jar \
    https://jdbc.postgresql.org/download/postgresql-42.7.3.jar
